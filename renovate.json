{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "npm tools which the models and API example checks run with npx",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/(models|apis)/main\\.go$/"],
      "matchStrings": [
        "= \"(?<depName>@?[a-z0-9][a-z0-9./-]*)@(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
