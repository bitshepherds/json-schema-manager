# validate warns about a structural change in the direction the family protects, when no document
# shows it, and jsm diff lists every structural change (#45, #122)

exec git init -q
env JSM_REGISTRY_ROOT_DIR=reg

# 1.1.0 adds an enum value which no 1.1.0 pass document uses: the compatibility check passes,
# and validate warns, exiting 0
exec jsm validate shop_order_1_1_0 -c
stdout 'Unexercised changes: no document shows these'
stdout '\[WARN\] shop_order_1_1_0.schema.json since shop_order_1_0_0:'
stdout '! /status: enum adds "refunded" \(widens\)'
stdout 'Test summary: 4 passed, 0 failed, 1 unexercised change$'

# The same for every schema, and in the JSON report
exec jsm validate all -c -C
stdout '1 unexercised change'
exec jsm validate all -o json -C
stdout '"totalUnexercised": 1'
stdout '"schema": "shop_order_1_1_0"'
stdout '"earlier": "shop_order_1_0_0"'
stdout '"later": "shop_order_1_1_0"'
stdout '"direction": "widens"'
stdout '"location": "/status"'
stdout '"effect": "widens"'

# jsm diff lists the changes: the new enum value is unexercised, and requiring a property and
# tightening a limit narrow the schema, which is safe for consumers of 1.0.0
exec jsm diff shop_order_1_0_0 shop_order_1_1_0
stdout 'Changes from shop_order_1_0_0 to shop_order_1_1_0:'
stdout 'widens   /status: enum adds "refunded" \(no pass document uses it\)'
stdout 'narrows  /: required requires "total"'
stdout 'narrows  /note: maxLength tightens the limit from 100 to 50'

exec jsm diff shop_order_1_0_0 shop_order_1_0_0
stdout 'No structural changes from shop_order_1_0_0 to shop_order_1_0_0'

! exec jsm diff shop_order_1_0_0 missing_thing_1_0_0
stderr 'Error:'

# Adding a pass document which uses the new value clears the warning, and the compatibility
# check then fails, as 1.0.0 rejects it
cp refunded.json reg/shop/order/1/1/0/pass/refunded.json
exec jsm diff shop_order_1_0_0 shop_order_1_1_0
stdout 'enum adds "refunded" \(used by pass/refunded.json\)'
! exec jsm validate shop_order_1_1_0 -c
! stdout 'unexercised change'
stdout 'Test summary: 4 passed, 1 failed$'

# jsm diff follows the family's scenario: a reader-ahead family asks for a fail document for each
# narrowing, and a widening is harmless to it, so it flags none
cp consumer-first.yml reg/shop/order/family.yml
exec jsm diff shop_order_1_0_0 shop_order_1_1_0
stdout 'widens   /status: enum adds "refunded" \(used by pass/refunded.json\)'
stdout 'narrows  /: required requires "total" \(no fail document shows it\)'
stdout 'narrows  /note: maxLength tightens the limit from 100 to 50 \(no fail document shows it\)'

# A fail document which shows a narrowing is named
cp no-total.json reg/shop/order/1/1/0/fail/no-total.json
exec jsm diff shop_order_1_0_0 shop_order_1_1_0
stdout 'narrows  /: required requires "total" \(shown by fail/no-total.json\)'

# A neither family flags nothing, and still lists every change
cp lock-step.yml reg/shop/order/family.yml
rm reg/shop/order/1/1/0/pass/refunded.json
exec jsm diff shop_order_1_0_0 shop_order_1_1_0
stdout 'widens   /status: enum adds "refunded"$'
stdout 'narrows  /note: maxLength tightens the limit from 100 to 50$'
! stdout 'no (pass|fail) document'

-- consumer-first.yml --
scenario: consumer-first
-- lock-step.yml --
scenario: lock-step
-- no-total.json --
{"status": "paid"}
-- refunded.json --
{"status": "refunded", "total": 3}
-- reg/json-schema-manager-config.yml --
environments:
  production:
    privateUrlRoot: "https://json-schemas.internal.myorg.io/"
    publicUrlRoot: "https://json-schemas.myorg.io/"
    isProduction: true
-- reg/shop/order/1/0/0/shop_order_1_0_0.schema.json --
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
  "properties": {
    "status": { "enum": ["placed", "paid"] },
    "total": { "type": "number" },
    "note": { "type": "string", "maxLength": 100 }
  }
}
-- reg/shop/order/1/0/0/pass/paid.json --
{"status": "paid", "total": 3}
-- reg/shop/order/1/0/0/fail/unknown-status.json --
{"status": "lost"}
-- reg/shop/order/1/1/0/shop_order_1_1_0.schema.json --
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
  "properties": {
    "status": { "enum": ["placed", "paid", "refunded"] },
    "total": { "type": "number" },
    "note": { "type": "string", "maxLength": 50 }
  },
  "required": ["total"]
}
-- reg/shop/order/1/1/0/pass/paid.json --
{"status": "paid", "total": 3}
-- reg/shop/order/1/1/0/fail/unknown-status.json --
{"status": "lost", "total": 3}
-- reg/shop/order/family.yml --
scenario: provider-first
