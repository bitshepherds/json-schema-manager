# validate exits 0 only when every test passes (#40), and -o junit writes a JUnit report

# Every test passes: exit 0
env JSM_REGISTRY_ROOT_DIR=ok
exec jsm validate shop_order_1_0_0 -c
stdout 'Test summary: 2 passed, 0 failed'
! stderr 'Error:'
exec jsm validate shop_order_1_0_0 -c -o json
stdout '"totalFailed": 0'
exec jsm validate shop_order_1_0_0 -c -o junit
stdout '<testsuites name="jsm validate" tests="2" failures="0"'
stdout '<testsuite name="shop_order_1_0_0.schema.json" tests="2" failures="0">'
stdout '<testcase name=".*fail/lost.json" classname="shop_order_1_0_0.schema.json"></testcase>'

# A fail/ document passes: non-zero exit, with the report and no extra error line
env JSM_REGISTRY_ROOT_DIR=localfail
! exec jsm validate shop_order_1_0_0 -c
stdout 'passed, when expected fail'
stdout 'Test summary: 1 passed, 1 failed'
! stderr 'Error:'
! exec jsm validate shop_order_1_0_0 -c -o json
stdout '"totalFailed": 1'
! stderr 'Error:'
! exec jsm validate shop_order_1_0_0 -c -o junit
stdout '<testsuites name="jsm validate" tests="2" failures="1"'
stdout '<failure message="passed, when expected fail">'
! stderr 'Error:'

# A newer version's pass/ document breaks an earlier version: non-zero exit
env JSM_REGISTRY_ROOT_DIR=breaking
! exec jsm validate shop_order_1_1_0 -c
stdout 'future version 1.1.0 introduced a breaking change'
stdout 'Test summary: 2 passed, 1 failed'
! stderr 'Error:'
! exec jsm validate shop_order_1_1_0 -c -o json
stdout '"totalFailed": 1'

# Multi-schema targets fail too
env JSM_REGISTRY_ROOT_DIR=localfail
! exec jsm validate all -c
stdout 'Test summary: 1 passed, 1 failed'

-- ok/json-schema-manager-config.yml --
environments:
  production:
    privateUrlRoot: "https://json-schemas.internal.myorg.io/"
    publicUrlRoot: "https://json-schemas.myorg.io/"
    isProduction: true
-- ok/shop/order/1/0/0/shop_order_1_0_0.schema.json --
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
  "properties": { "status": { "enum": ["placed", "paid"] } },
  "required": ["status"]
}
-- ok/shop/order/1/0/0/pass/placed.json --
{"status": "placed"}
-- ok/shop/order/1/0/0/fail/lost.json --
{"status": "lost"}
-- localfail/json-schema-manager-config.yml --
environments:
  production:
    privateUrlRoot: "https://json-schemas.internal.myorg.io/"
    publicUrlRoot: "https://json-schemas.myorg.io/"
    isProduction: true
-- localfail/shop/order/1/0/0/shop_order_1_0_0.schema.json --
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
  "properties": { "status": { "enum": ["placed", "paid"] } },
  "required": ["status"]
}
-- localfail/shop/order/1/0/0/pass/placed.json --
{"status": "placed"}
-- localfail/shop/order/1/0/0/fail/paid.json --
{"status": "paid"}
-- breaking/json-schema-manager-config.yml --
environments:
  production:
    privateUrlRoot: "https://json-schemas.internal.myorg.io/"
    publicUrlRoot: "https://json-schemas.myorg.io/"
    isProduction: true
-- breaking/shop/order/1/0/0/shop_order_1_0_0.schema.json --
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
  "properties": { "status": { "enum": ["placed", "paid"] } },
  "required": ["status"]
}
-- breaking/shop/order/1/0/0/pass/placed.json --
{"status": "placed"}
-- breaking/shop/order/1/0/0/fail/lost.json --
{"status": "lost"}
-- breaking/shop/order/1/1/0/shop_order_1_1_0.schema.json --
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
  "properties": { "status": { "enum": ["placed", "paid", "refunded"] } },
  "required": ["status"]
}
-- breaking/shop/order/1/1/0/pass/refunded.json --
{"status": "refunded"}
-- breaking/shop/order/1/1/0/fail/lost.json --
{"status": "lost"}
