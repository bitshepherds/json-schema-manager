{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
  "properties": { "status": { "enum": ["placed", "paid"] } },
  "required": ["status"]
}
-- ok/shop/order/1/0/0/pass/placed.json --
{"status": "placed"}
-- ok/shop/order/1/0/0/fail/lost.json --
{"status": "lost"}
-- ok/shop/order/1/1/0/shop_order_1_1_0.schema.json --
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
