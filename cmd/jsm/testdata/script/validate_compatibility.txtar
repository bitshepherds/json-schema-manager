# Every validate target runs the same pairs, which the family's declaration decides (#42, #119)
# 1.1.0 adds an enum value, and a pass/ document that uses it, which 1.0.0 rejects. The family is
# owner-writes, so that breaks a reader still on 1.0.0.

env JSM_REGISTRY_ROOT_DIR=reg

# A single key catches the breaking change
! exec jsm validate shop_order_1_1_0 -c
stdout '✗ no-loosening broken: pass document of 1.1.0 rejected by 1.0.0:'
stdout 'Test summary: 2 runs passed, 1 failed'

# The failure names the document once, by its path from the registry's root, wherever the registry is
# and however it is given: the report is the same each way, and never names the work directory (#156)
env FAILURE='^\[FAIL\] shop_order_1_1_0.schema.json \(runs: 2 passed, 1 failed\)\n  ✗ no-loosening broken: pass document of 1.1.0 rejected by 1.0.0:\n    no-loosening broken between shop_order_1_0_0 and shop_order_1_1_0: pass document shop/order/1/1/0/pass/refunded.json of shop_order_1_1_0 was rejected by shop_order_1_0_0. In an owner-writes family, a writer on shop_order_1_1_0 can send a reader still on shop_order_1_0_0 a document it rejects. Undo the change, or make it in a new major version. If this is deliberate, or shop_order_1_1_0 is already deployed, list it in compat-exceptions.yml in shop_order_1_1_0''s directory. Detail: jsonschema validation failed with ''https://json-schemas.internal.myorg.io/shop_order_1_0_0.schema.json#''\n- at ''/status'': value must be one of ''placed'', ''paid''\n-{40}\n'
! exec jsm validate shop_order_1_1_0 -c
stdout -count=1 'refunded.json'
! stdout ${WORK@R}
stdout $FAILURE

env JSM_REGISTRY_ROOT_DIR=$WORK/reg
! exec jsm validate shop_order_1_1_0 -c
stdout -count=1 'refunded.json'
! stdout ${WORK@R}
stdout $FAILURE

env JSM_REGISTRY_ROOT_DIR=
! exec jsm validate shop_order_1_1_0 -c -r $WORK/reg
stdout -count=1 'refunded.json'
! stdout ${WORK@R}
stdout $FAILURE

cd reg
! exec jsm validate shop_order_1_1_0 -c -r .
stdout -count=1 'refunded.json'
! stdout ${WORK@R}
stdout $FAILURE
cd $WORK
env JSM_REGISTRY_ROOT_DIR=reg

# So does the earlier version, which is part of the pair, and it reports under the later version
! exec jsm validate shop_order_1_0_0 -c -C
stdout '\[FAIL\] shop_order_1_1_0.schema.json'
stdout 'no-loosening broken between shop_order_1_0_0 and shop_order_1_1_0'

# The article follows the scenario's name: "an owner-writes family", never "a owner-writes" (#153)
stdout 'In an owner-writes family'
! stdout 'a owner-'
stdout 'Test summary: 3 runs passed, 1 failed'

# So does every multi-schema target, including the bare command CI runs, each run once
! exec jsm validate all
stdout 'no-loosening broken'

! exec jsm validate all -c -C
stdout '✗ no-loosening broken: pass document of 1.1.0 rejected by 1.0.0:'
stdout 'Test summary: 5 runs passed, 1 failed'

! exec jsm validate shop/order -c -C
stdout 'no-loosening broken'
stdout 'Test summary: 5 runs passed, 1 failed'

! exec jsm validate reg/shop/order -c -C
stdout 'no-loosening broken'

# A search scope holding only the later version gives the same verdict as its key
! exec jsm validate shop/order/1/1/0 -c -C
stdout 'Test summary: 3 runs passed, 1 failed'

# The flags that used to change what runs are gone
! exec jsm validate all --skip-compatible
stderr 'unknown flag: --skip-compatible'
! exec jsm validate all -t local
stderr 'unknown shorthand flag: .t.'

# A failure names the schema that rejected the document, 1.0.0 (#50)
! exec jsm validate all -c -C
stdout 'refunded.json of shop_order_1_1_0 was rejected by shop_order_1_0_0\.'
! stdout 'rejected by shop_order_1_1_0'

# The JSON report names the rule, both versions and the document
! exec jsm validate shop_order_1_1_0 -o json
stdout '"validatedBy": "shop_order_1_0_0"'
stdout '"rule": "no-loosening"'
stdout '"earlier": "shop_order_1_0_0"'
stdout '"later": "shop_order_1_1_0"'
stdout '"documentFrom": "shop_order_1_1_0"'
stdout '"passed": \['
! stdout 'null'

# The JUnit report shows the run under the later version, naming the version it ran on
! exec jsm validate all -C -o junit
stdout '<testsuite name="shop_order_1_1_0.schema.json"'
stdout 'refunded.json on shop_order_1_0_0'
stdout '<failure message="no-loosening broken: pass document of 1.1.0 rejected by 1.0.0">'

# Declared lock-step, the same versions never meet, so only their own documents run
cp lock-step.yml reg/shop/order/family.yml
exec jsm validate all -c -C
stdout 'Test summary: 4 runs passed, 0 failed'

-- lock-step.yml --
scenario: lock-step
-- reg/json-schema-manager-config.yml --
environments:
  production:
    privateUrlRoot: "https://json-schemas.internal.myorg.io/"
    publicUrlRoot: "https://json-schemas.myorg.io/"
    isProduction: true
-- reg/shop/order/1/0/0/shop_order_1_0_0.schema.json --
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
  "properties": { "status": { "enum": ["placed", "paid"] } },
  "required": ["status"]
}
-- reg/shop/order/1/0/0/pass/placed.json --
{"status": "placed"}
-- reg/shop/order/1/0/0/fail/lost.json --
{"status": "lost"}
-- reg/shop/order/1/1/0/shop_order_1_1_0.schema.json --
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "type": "object",
  "properties": { "status": { "enum": ["placed", "paid", "refunded"] } },
  "required": ["status"]
}
-- reg/shop/order/1/1/0/pass/refunded.json --
{"status": "refunded"}
-- reg/shop/order/1/1/0/fail/lost.json --
{"status": "lost"}
-- reg/shop/order/family.yml --
scenario: owner-writes
